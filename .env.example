PORT=8787
TOKEN_SECRET=change-this-to-a-strong-secret
FRONTEND_ORIGIN=http://localhost:5173
# Optional additional allowed web origins for CORS (comma-separated).
# Example: FRONTEND_ORIGINS=https://www.lillasy.com,https://lillasy.com
FRONTEND_ORIGINS=
EXPOSE_DEV_TOKENS=false

# Database (Prisma)
# Local development (default) — SQLite file in the project root.
DATABASE_URL="file:./dev.db"
# Supabase / Postgres example (uncomment + replace, set provider to "postgresql"
# in prisma/schema.prisma, then run `pnpm prisma db push`).
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Google OAuth (Web application credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# Sephora live crawler
# Set to "true" to let the in-process scheduler refresh enabled targets daily.
SEPHORA_CRAWLER_ENABLED=false
# Hours between automatic refreshes. Defaults to 24 (= once per day).
SEPHORA_CRAWLER_INTERVAL_HOURS=24
# Override the User-Agent the crawler uses; leave blank for the bundled default.
SEPHORA_USER_AGENT=
# Which fetcher to use: "fetch" (default, fast but Sephora blocks it with Akamai)
# or "playwright" (real Chromium, bypasses the JS bot challenge).
# Run `pnpm exec playwright install chromium` once before using "playwright".
SEPHORA_FETCHER=fetch
# Optional Playwright tuning. headless=false pops a visible window (least bot-detected).
# channel=chrome uses the locally installed Chrome for browser fingerprint.
# Proxy goes through SEPHORA_PLAYWRIGHT_PROXY (or HTTPS_PROXY) — point this at a
# residential proxy if Akamai blocks your datacenter/VPN IP.
SEPHORA_PLAYWRIGHT_HEADLESS=true
# SEPHORA_PLAYWRIGHT_CHANNEL=chrome
# Persistent context reuses cookies/session between runs (recommended for stealth).
SEPHORA_PLAYWRIGHT_PERSISTENT=true
# Optional: pin to a specific Chrome user-data directory (overrides PERSISTENT).
# SEPHORA_PLAYWRIGHT_USER_DATA_DIR=
# Warm up the session by visiting sephora.com before product pages.
SEPHORA_PLAYWRIGHT_WARMUP=true
# Reset the browser context after N consecutive bot challenges (default 2).
SEPHORA_PLAYWRIGHT_RESET_AFTER_BLOCKS=2
# Delay between product requests in ms. 30000 (30s) is the production default.
# Lower it (e.g. 5000) only when you have a fresh proxy / residential IP.
SEPHORA_REQUEST_DELAY_MS=30000
# SEPHORA_PLAYWRIGHT_PROXY=http://user:pass@proxy.example.com:8000
# SEPHORA_PLAYWRIGHT_PROXY_USERNAME=
# SEPHORA_PLAYWRIGHT_PROXY_PASSWORD=

# Optional: Slack/Discord-compatible incoming webhook for crawler alerts.
# Triggered on high failure rate, consecutive failures, bot-blocking ratio,
# and stale targets. See docs/sephora-schema-v1.md for thresholds.
# SEPHORA_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Product pipeline auto-reprocess scheduler
# Re-runs matching/enrichment for Amazon sources whose linked Product is
# currently in non-final states (default: comparison_only).
PRODUCT_PIPELINE_REPROCESS_ENABLED=false
# Hours between automatic batch runs.
PRODUCT_PIPELINE_REPROCESS_INTERVAL_HOURS=24
# Comma-separated Product.status values to target.
PRODUCT_PIPELINE_REPROCESS_STATUSES=comparison_only
# Max Amazon sources to reprocess per run.
PRODUCT_PIPELINE_REPROCESS_BATCH_SIZE=25
# Max discovered enrichment candidates per Amazon source.
PRODUCT_PIPELINE_REPROCESS_CANDIDATE_LIMIT=60
