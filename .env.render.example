# Render production environment template
# Copy values into Render -> Service -> Environment

TOKEN_SECRET=__AUTO_GENERATED_BY_RENDER_IF_USING_BLUEPRINT__
FRONTEND_ORIGIN=https://www.lillasy.com
FRONTEND_ORIGINS=https://www.lillasy.com,https://lillasy.com
EXPOSE_DEV_TOKENS=false

DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.lillasy.com/api/auth/google/callback

SEPHORA_CRAWLER_ENABLED=false
SEPHORA_CRAWLER_INTERVAL_HOURS=24
# Render's datacenter IPs are usually flagged by Akamai. For production live
# crawling, run the crawler from a separate worker behind a residential proxy
# (configure SEPHORA_PLAYWRIGHT_PROXY) or use a managed scraper API.
SEPHORA_FETCHER=fetch
SEPHORA_PLAYWRIGHT_PERSISTENT=true
SEPHORA_PLAYWRIGHT_WARMUP=true
SEPHORA_PLAYWRIGHT_RESET_AFTER_BLOCKS=2
SEPHORA_REQUEST_DELAY_MS=30000
# Optional Slack/Discord-compatible webhook for crawl-failure alerts.
# SEPHORA_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
